# Server config. Real env vars win over this file (Bun loads .env natively), except the
# RIVET* ones: RivetKit's native side only sees variables set before the process starts.
# PORT=8787
# Where the Rivet engine keeps every actor's state. Mount the Railway volume and point here.
# RIVETKIT_STORAGE_PATH=/data/rivet
# RIVET_LOG_LEVEL=error
# NODE_ENV=production
# Company websites: Firecrawl reads the brand (colours, logo), Claude turns it into house
# colours. Without FIRECRAWL_API_KEY a website only goes on the sign; without
# ANTHROPIC_API_KEY the site's own colours are used as they are.
# FIRECRAWL_API_KEY=fc-...
# ANTHROPIC_API_KEY=sk-ant-...
