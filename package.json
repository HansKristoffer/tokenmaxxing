{
  "name": "tokenmaxxing",
  "version": "0.5.0",
  "private": true,
  "description": "A tiny pixel town for people who run AI coding agents, with a macOS menu bar app that syncs your token usage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HansKristoffer/tokenmaxxing"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "token-usage",
    "leaderboard",
    "menu-bar",
    "pixel-art",
    "multiplayer",
    "rivet",
    "bun"
  ],
  "type": "module",
  "workspaces": [
    "core",
    "server",
    "web",
    "app/helper"
  ],
  "scripts": {
    "dev": "RIVETKIT_STORAGE_PATH=.data/rivet RIVET_LOG_LEVEL=error bun --watch server/src/main.ts",
    "dev:seed": "bun server/scripts/dev-seed.ts",
    "app:dev": "bash app/scripts/build-app.sh dev && open app/build/Tokenmaxxing.app",
    "app:build": "bash app/scripts/build-app.sh release",
    "helper:once": "bun app/helper/src/main.ts --once",
    "test": "bun test",
    "typecheck": "tsc -p core && tsc -p server && tsc -p web && tsc -p app/helper",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "vendor:pricing": "bun server/scripts/vendor-pricing.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
